# ── Azure OCR ──────────────────────────────────────────────────────
AZURE_DOC_ENDPOINT=https://your-doc-intelligence.cognitiveservices.azure.com
AZURE_DOC_KEY=your-doc-key

# ── Extraction Backend ───────────────────────────────────────────
# "docling" = Docling (local) + Gemini LLM extraction  (primary, default)
# "azure"   = Azure Document Intelligence 4.0           (fallback / legacy)
EXTRACTION_BACKEND=docling
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── Azure Content Understanding ───────────────────────────────────
AZURE_CU_ENDPOINT=https://your-cu.cognitiveservices.azure.com
AZURE_CU_KEY=your-cu-key
AZURE_CU_ANALYZER_ID=your-analyzer-id

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Database (Neon / Postgres with pgvector) ──────────────────────
NEON_CONNECTION_STRING=postgresql://user:pass@host/dbname

# ── AWS S3 ────────────────────────────────────────────────────────
# Keys are OPTIONAL when running on EC2/ECS/Lambda (IAM role auth).
# Set them explicitly only for local development.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# IMPORTANT: region MUST be ap-south-1 for the teclusion-datalake-idp bucket
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=teclusion-datalake-idp

# Prefix for direct PDF uploads via /rag/ingest
S3_PDF_PREFIX=documents/

# ── S3 Datalake ───────────────────────────────────────────────────
# Prefix under which source PDFs live in the datalake bucket
S3_DATALAKE_PREFIX=datalake/
# Safety limit: max PDFs ingested per /sync call (default 500)
S3_SYNC_MAX_FILES=500

# ── API key (simple dev auth) ────────────────────────────────────
# When set, protected endpoints require X-API-Key header.
# Leave empty to disable auth (local dev).
API_KEY=

# ── SharePoint / Microsoft Graph (app-only auth) ────────────────
# Register an Azure AD App Registration with Application permissions:
#   Sites.Read.All, Files.Read.All  – then grant Admin Consent.
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
# Provide EITHER site_id directly OR site_url to auto-resolve.
SHAREPOINT_SITE_ID=
SHAREPOINT_SITE_URL=
# Drive ID – leave empty to auto-resolve the default document library.
SHAREPOINT_DRIVE_ID=
# Folder path inside the document library.
SHAREPOINT_FOLDER_PATH=Shared Documents/datalake
# Safety limit for sync
SHAREPOINT_SYNC_MAX_FILES=500

# ── Google Drive ─────────────────────────────────────────────────
# Auth mode 1: OAuth2 refresh token (personal Drive / testing)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Auth mode 2: Service Account (Workspace + domain-wide delegation)
GDRIVE_USE_SERVICE_ACCOUNT=false
GDRIVE_SERVICE_ACCOUNT_JSON=   # file path or raw JSON string
GDRIVE_DELEGATED_USER=         # impersonated user email (SA only)
# Folder ID of the root folder to list / sync
GDRIVE_FOLDER_ID=
# Safety limit
GDRIVE_SYNC_MAX_FILES=500

# ── Firebase ──────────────────────────────────────────────────────
# Path to Firebase Admin SDK service account JSON key file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/your-firebase-service-account.json
